rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and write access for doctors, appointments, landingConfig, banners, specialties
    // In this medical SaaS platform, public patients book appointments and view doctor sites,
    // while doctors and admins manage data seamlessly.
    match /doctors/{doctorId} {
      allow read, write: if true;
    }
    
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }
    
    match /landingConfig/{configId} {
      allow read, write: if true;
    }
    
    match /banners/{bannerId} {
      allow read, write: if true;
    }
    
    match /specialties/{specialtyId} {
      allow read, write: if true;
    }
  }
}
